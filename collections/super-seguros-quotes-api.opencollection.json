{
  "opencollection": "1.0.0",
  "info": {
    "name": "Super Seguros Quotes API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Quotes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of quotes for a customer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.super.mx/api/v2/:product/quotes",
            "params": [
              {
                "name": "product",
                "value": "life",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Get a list of quotes for a customer"
        }
      ]
    }
  ],
  "bundled": true
}